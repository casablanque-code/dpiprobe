#!/usr/bin/env bash
# dpi - drive the DPI lab (network namespaces: cl - dpi - sv). Run `dpi help`.
set -u
REPO=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
BIN=${DPI_BIN:-$REPO/target/release/dpiprobe}
PY=${DPI_PY:-/root/lab/venv/bin/python}
RUN=/run/dpi
SRV=10.0.2.2

die() { echo "error: $*" >&2; exit 1; }
alive() { [[ -f $1 ]] && kill -0 "$(cat "$1")" 2>/dev/null; }
wait_for() { local i; for i in $(seq 50); do grep -q "$2" "$1" 2>/dev/null && return 0; sleep 0.1; done; return 1; }
nsx() { local ns=$1; shift; ip netns exec "$ns" "$@"; }
rep() { local i; for ((i = 0; i < $1; i++)); do printf '─'; done; }

# box "title" line...   (ASCII content only)
box() {
  local title=$1 w l; shift
  w=$((${#title} + 4))
  for l in "$@"; do (( ${#l} > w )) && w=${#l}; done
  (( w < 44 )) && w=44
  printf '┌─ %s %s┐\n' "$title" "$(rep $((w - ${#title} - 1)))"
  for l in "$@"; do printf '│ %-*s │\n' "$w" "$l"; done
  printf '└%s┘\n' "$(rep $((w + 2)))"
}

read -r -d '' PYCHK <<'PY'
import sys, json
exp = sys.argv[1]
last = None
for l in sys.stdin:
    try:
        r = json.loads(l)
    except ValueError:
        continue
    if 'cmd' in r:
        last = r
if not last:
    print('FAIL no output from dpiprobe'); sys.exit(1)
got = last['result']
print(('PASS' if got == exp else 'FAIL') + ' got=' + got)
sys.exit(0 if got == exp else 1)
PY

read -r -d '' PYCFG <<'PY'
import sys, json
base, out, *kv = sys.argv[1:]
c = json.load(open(base))
for a in kv:
    k, _, v = a.partition('=')
    if v in ('true', 'false'):
        v = (v == 'true')
    elif v.lstrip('-').isdigit():
        v = int(v)
    c[k] = v
json.dump(c, open(out, 'w'))
PY

read -r -d '' PYSHOW <<'PY'
import sys, json
c = json.load(open(sys.argv[1]))
print(' '.join('%s=%s' % (k, str(v).lower() if isinstance(v, bool) else ('""' if v == '' else v)) for k, v in c.items() if k != 'desc'))
PY

read -r -d '' PYPROF <<'PY'
import sys, json, glob, os
for f in sorted(glob.glob(sys.argv[1] + '/*.json')):
    print('%-18s %s' % (os.path.basename(f)[:-5], json.load(open(f)).get('desc', '')))
PY

cfg_build() { local base=$1; shift; python3 -c "$PYCFG" "$base" "$RUN/dpi.json" "$@"; }
cfg_show() { [[ -f $RUN/dpi.json ]] && python3 -c "$PYSHOW" "$RUN/dpi.json"; }

lab_up() {
  [[ -e /run/netns/cl && -e /run/netns/dpi && -e /run/netns/sv ]] && return 0
  local n; for n in cl dpi sv; do ip netns del $n 2>/dev/null; done
  ip netns add cl; ip netns add dpi; ip netns add sv
  ip link add c0 type veth peer name d0
  ip link add d1 type veth peer name s0
  ip link set c0 netns cl; ip link set d0 netns dpi
  ip link set d1 netns dpi; ip link set s0 netns sv
  nsx cl ip addr add 10.0.1.2/24 dev c0
  nsx dpi ip addr add 10.0.1.1/24 dev d0
  nsx dpi ip addr add 10.0.2.1/24 dev d1
  nsx sv ip addr add 10.0.2.2/24 dev s0
  for n in cl dpi sv; do nsx $n ip link set lo up; done
  nsx cl ip link set c0 up; nsx dpi ip link set d0 up
  nsx dpi ip link set d1 up; nsx sv ip link set s0 up
  nsx cl ip route add default via 10.0.1.1
  nsx sv ip route add default via 10.0.2.1
  nsx dpi sysctl -qw net.ipv4.ip_forward=1
}

# The nft rule that sends forwarded TCP to the DPI process. Removing it makes the lab transparent.
rule_on() {
  nsx dpi nft add table inet f
  nsx dpi nft 'add chain inet f fw { type filter hook forward priority 0; }'
  nsx dpi nft flush chain inet f fw
  nsx dpi nft add rule inet f fw meta l4proto tcp queue num 0
}
rule_off() { nsx dpi nft flush chain inet f fw 2>/dev/null; }

dpi_stop() {
  rule_off
  alive "$RUN/dpi.pid" && kill "$(cat "$RUN/dpi.pid")" 2>/dev/null
  pkill -f 'lab/dpi.py' 2>/dev/null
  rm -f "$RUN/dpi.pid"; sleep 0.2
  return 0
}

dpi_start() {
  [[ -f $REPO/lab/dpi.py ]] || die "missing $REPO/lab/dpi.py"
  [[ -x $PY ]] || die "no python for the DPI process: $PY (set DPI_PY=...)"
  dpi_stop
  : > "$RUN/dpi.log"
  ip netns exec dpi nohup "$PY" "$REPO/lab/dpi.py" "$RUN/dpi.json" >> "$RUN/dpi.log" 2>&1 < /dev/null &
  echo $! > "$RUN/dpi.pid"
  wait_for "$RUN/dpi.log" '"ev": "start"' || die "DPI failed to start, see: dpi log"
  rule_on
}

server_on() {
  alive "$RUN/srv.pid" && return 0
  [[ -x $BIN ]] || die "missing $BIN (run: cd $REPO && cargo build --release)"
  pkill -f 'dpiprobe server' 2>/dev/null
  : > "$RUN/srv.log"
  ip netns exec sv nohup "$BIN" server >> "$RUN/srv.log" 2>&1 < /dev/null &
  echo $! > "$RUN/srv.pid"
  wait_for "$RUN/srv.log" 'listening' || die "server failed to start, see: dpi log srv"
}

server_off() {
  alive "$RUN/srv.pid" && kill "$(cat "$RUN/srv.pid")" 2>/dev/null
  pkill -f 'dpiprobe server' 2>/dev/null
  rm -f "$RUN/srv.pid"
  return 0
}

profile_desc() { python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get('desc',''))" "$1"; }

cmd_on() {
  local prof
  if [[ -z ${1:-} || $1 == *=* ]]; then prof=sni-rst; else prof=$1; shift; fi
  [[ -f $REPO/lab/profiles/$prof.json ]] || die "no such profile '$prof' (see: dpi profiles)"
  lab_up; server_on
  cfg_build "$REPO/lab/profiles/$prof.json" "$@"
  if [[ $# -eq 0 ]]; then echo "$prof" > "$RUN/profile"; else echo "$prof+" > "$RUN/profile"; fi
  dpi_start
  box "DPI ON: $prof" "$(profile_desc "$REPO/lab/profiles/$prof.json")" "$(cfg_show)"
}

cmd_set() {
  [[ $# -gt 0 ]] || die "usage: dpi set key=value ...   e.g. dpi set stateful=true max_pkts=1"
  [[ -f $RUN/dpi.json ]] || die "run 'dpi on' first"
  lab_up; server_on
  cfg_build "$RUN/dpi.json" "$@"
  echo "custom" > "$RUN/profile"
  dpi_start
  box "DPI reconfigured" "$(cfg_show)"
}

cmd_off() { dpi_stop; echo "DPI off: the lab network is transparent."; }

cmd_status() {
  local lab=down dpi=off srv=off cfg=""
  [[ -e /run/netns/dpi ]] && lab=up
  alive "$RUN/srv.pid" && srv=on
  if alive "$RUN/dpi.pid"; then dpi="ON ($(cat "$RUN/profile" 2>/dev/null))"; cfg=$(cfg_show); fi
  if [[ -n $cfg ]]; then
    box "dpi lab" "lab      $lab" "dpi      $dpi" "server   $srv" "config   $cfg"
  else
    box "dpi lab" "lab      $lab" "dpi      $dpi" "server   $srv"
  fi
}

cmd_log() {
  local f=$RUN/dpi.log
  [[ ${1:-} == srv ]] && { f=$RUN/srv.log; shift; }
  if [[ ${1:-} == -f ]]; then tail -n 20 -f "$f"; else tail -n 30 "$f"; fi
}

# run_tool <subcommand> <default flag> <default value> args...
# Adds the lab server address and a default SNI unless the caller gave one.
run_tool() {
  local sub=$1 flag=$2 val=$3; shift 3
  lab_up; server_on
  [[ -z $flag || " $* " == *" $flag "* ]] || set -- "$flag" "$val" "$@"
  nsx cl "$BIN" "$sub" --server $SRV "$@"
}

cmd_test() {
  local filter=${1:-} pass=0 fail=0 prof args exp out res st cur t0=$SECONDS
  local tests=$REPO/lab/tests.tsv
  [[ -f $tests ]] || die "missing $tests"
  lab_up; server_on
  while IFS='|' read -r -u 3 prof args exp; do
    prof=$(echo $prof); args=$(echo $args); exp=$(echo $exp)
    [[ -z $prof || $prof == \#* ]] && continue
    [[ -n $filter && "$prof $args" != *$filter* ]] && continue
    cur=$(cat "$RUN/profile" 2>/dev/null)
    if [[ $cur != "$prof" ]] || ! alive "$RUN/dpi.pid"; then
      [[ -f $REPO/lab/profiles/$prof.json ]] || die "no such profile '$prof' (test: $args)"
      cfg_build "$REPO/lab/profiles/$prof.json"; echo "$prof" > "$RUN/profile"; dpi_start
    fi
    out=$(nsx cl "$BIN" $args --server $SRV --timeout 2 --json 2>&1)
    res=$(printf '%s\n' "$out" | python3 -c "$PYCHK" "$exp")
    st=${res%% *}
    [[ $st == PASS ]] && pass=$((pass + 1)) || fail=$((fail + 1))
    printf '%-4s  %-18s %-60s want=%-12s %s\n' "$st" "$prof" "$args" "$exp" "${res#* }"
  done 3< "$tests"
  echo
  box "dpi test" "passed  $pass" "failed  $fail" "time    $((SECONDS - t0))s"
  [[ $fail -eq 0 ]]
}

cmd_profiles() { python3 -c "$PYPROF" "$REPO/lab/profiles"; }

cmd_down() { dpi_stop; server_off; local n; for n in cl dpi sv; do ip netns del $n 2>/dev/null; done; echo "lab removed."; }

cmd_doctor() {
  local rows=() bad=0
  chk() { if eval "$2" > /dev/null 2>&1; then rows+=("[ ok ]  $1"); else rows+=("[FAIL]  $1"); bad=1; fi; }
  chk "running as root"                    '[[ $EUID -eq 0 ]]'
  chk "ip (iproute2) installed"            'command -v ip'
  chk "nft installed"                      'command -v nft'
  chk "python3 installed"                  'command -v python3'
  chk "DPI python has netfilterqueue+scapy ($PY)" '"$PY" -c "import netfilterqueue, scapy"'
  chk "dpiprobe built ($BIN)"              '[[ -x $BIN ]]'
  chk "lab/dpi.py present"                 '[[ -f $REPO/lab/dpi.py ]]'
  chk "network namespaces usable"          'ip netns list'
  box "dpi doctor" "${rows[@]}"
  return $bad
}

cmd_help() {
  cat <<'H'
dpi - drive the DPI lab (network namespaces: cl -> dpi -> sv)

LAB CONTROL
  dpi on [profile] [k=v ..]   turn the DPI on (default profile: sni-rst); the lab and
                              the server start automatically
  dpi set k=v ..              change the running config, e.g. dpi set stateful=true max_pkts=1
  dpi off                     turn the DPI off (transparent network)
  dpi status                  what is running right now
  dpi profiles                list profiles (lab/profiles/*.json)
  dpi log [srv] [-f]          DPI log, or server log with `srv`; -f follows
  dpi doctor                  check prerequisites
  dpi down                    stop everything and delete the lab

MEASUREMENTS (run from the client side of the lab)
  dpi probe [opts]            classify the reaction to a blocked SNI (rst / drop / ...)
                              e.g. dpi probe --split-sni      (default --test-sni blocked.example)
  dpi depth [opts]            how many client packets does the DPI inspect?
  dpi threshold [opts]        after how many uploaded bytes does the DPI cut the flow?
  Every option of `dpiprobe <command> --help` works here.

TESTS
  dpi test [filter]           run lab/tests.tsv: each row is  profile | dpiprobe args | expected result
                              expected: probe -> tls_alert|rst|timeout, depth -> depth=N,
                              threshold -> cutoff=NKB|cutoff=none
  RAW output for scripts: add --json to any measurement.

TYPICAL SESSION
  dpi on sni-drop && dpi probe && dpi depth
H
}

[[ ${1:-help} =~ ^(help|-h|--help)$ ]] && { cmd_help; exit 0; }
[[ $EUID -eq 0 ]] || die "must run as root"
mkdir -p "$RUN"
c=$1; shift
case $c in
  up) lab_up; echo "lab ready." ;;
  on) cmd_on "$@" ;;
  set) cmd_set "$@" ;;
  off) cmd_off ;;
  status|st) cmd_status ;;
  probe|p) run_tool probe --test-sni blocked.example "$@" ;;
  depth|d) run_tool depth --sni blocked.example "$@" ;;
  threshold|th) run_tool threshold "" "" "$@" ;;
  test|t) cmd_test "$@" ;;
  profiles) cmd_profiles ;;
  log) cmd_log "$@" ;;
  doctor) cmd_doctor ;;
  down) cmd_down ;;
  *) echo "unknown command: $c" >&2; cmd_help; exit 1 ;;
esac
